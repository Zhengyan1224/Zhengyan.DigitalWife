<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-android</TargetFramework>
        <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
        <OutputType>Exe</OutputType>
        <ApplicationId>com.zhengyan.digitalwife.gameplayer</ApplicationId>
        <ApplicationTitle>Zhengyan DigitalWife GamePlayer</ApplicationTitle>
        <ApplicationVersion>1</ApplicationVersion>
        <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
        <!-- Replace this file or override AndroidApplicationIconPath at build time. -->
        <AndroidApplicationIconPath Condition="'$(AndroidApplicationIconPath)' == ''">$(MSBuildThisFileDirectory)..\..\assets\mmd\samples\GameData\Logo\favicon.png</AndroidApplicationIconPath>
        <!-- Keep project JSON model types available until the Android source-generated JSON context is complete. -->
        <TrimMode>partial</TrimMode>
        <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
        <!-- Mono's AOT async unwind allocator can abort at memory-manager.c:85
             (dotnet/runtime#129843; not backported to release/10.0). Use JIT
             until the Android runtime includes that fix. This also supports
             assemblies loaded from dwgame packages. An explicit build property
             can re-enable AOT when validating a fixed runtime. -->
        <RunAOTCompilation Condition="'$(RunAOTCompilation)' == ''">false</RunAOTCompilation>
        <AndroidEnableProfiledAot Condition="'$(RunAOTCompilation)' != 'true'">false</AndroidEnableProfiledAot>
    </PropertyGroup>

    <ItemGroup>
        <AndroidResource Include="$(AndroidApplicationIconPath)" Condition="Exists('$(AndroidApplicationIconPath)')">
            <Link>Resources\drawable\app_icon.png</Link>
        </AndroidResource>
        <!--
          Roslyn script submissions always emit an async factory returning Task<object>,
          even when the .csx source contains no await. These members are reached only
          from the dynamically emitted assembly, so the Android trimmer cannot discover
          them from the host's static call graph.
        -->
        <TrimmerRootDescriptor Include="AndroidScriptLinker.xml" />
        <AndroidAsset Include="$(DigitalWifeMmdEngineAssetsDir)**\*">
            <Link>Resources\%(RecursiveDir)%(Filename)%(Extension)</Link>
        </AndroidAsset>
        <None Include="$(DigitalWifeMmdEngineAssetsDir)**\*">
            <Link>Resources\%(RecursiveDir)%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" />
        <PackageReference Include="Evergine.BulletSharpPInvoke" />
        <PackageReference Include="Evergine.LibBulletc.Natives" />
        <PackageReference Include="Pfim" />
        <PackageReference Include="StbImageSharp" />
        <PackageReference Include="Veldrid" />
        <PackageReference Include="Veldrid.SPIRV" />
        <ProjectReference Include="..\Zhengyan.DigitalWife.GameProjects.Core\Zhengyan.DigitalWife.GameProjects.Core.csproj" />
        <ProjectReference Include="..\Zhengyan.DigitalWife.GamePlayer.Runtime.Core\Zhengyan.DigitalWife.GamePlayer.Runtime.Core.csproj" />
        <ProjectReference Include="..\Zhengyan.DigitalWife.GamePlayer.Android.Scripting\Zhengyan.DigitalWife.GamePlayer.Android.Scripting.csproj" />
        <Compile Include="..\Zhengyan.DigitalWife.GamePlayer\LoadingScreenComponent.cs" Link="Shared\LoadingScreenComponent.cs" />
        <ProjectReference Include="..\Zhengyan.DigitalWife.Mmd.Core\Zhengyan.DigitalWife.Mmd.Core.csproj" />
        <ProjectReference Include="..\Zhengyan.DigitalWife.Mmd.Game\Zhengyan.DigitalWife.Mmd.Game.csproj" />
        <!-- Mmd.Game depends on the full desktop MMD assembly. Keep that transitive assembly
             out of the global namespace because Android already consumes the linked Mmd.Core types. -->
        <ProjectReference Include="..\Zhengyan.DigitalWife.Mmd\Zhengyan.DigitalWife.Mmd.csproj" Aliases="MmdDesktop" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\tools\VeldridAndroidPatch\VeldridAndroidPatch.csproj"
                          ReferenceOutputAssembly="false" PrivateAssets="all"
                          GlobalPropertiesToRemove="RuntimeIdentifier;RuntimeIdentifiers;SelfContained" />
    </ItemGroup>

    <!-- Patch a private build copy before trimming/JNI processing. Never modify
         the NuGet cache, and never substitute the desktop Veldrid assembly. -->
    <Target Name="PatchAndroidVeldrid" AfterTargets="ComputeResolvedFilesToPublishList"
            BeforeTargets="PrepareForILLink" Condition="'$(DesignTimeBuild)' != 'true'">
        <ItemGroup>
            <_AndroidOriginalVeldrid Include="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'Veldrid.dll'" />
        </ItemGroup>
        <PropertyGroup>
            <_AndroidPatchedVeldrid>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)patched-vulkan\Veldrid.dll</_AndroidPatchedVeldrid>
            <_AndroidVeldridPatchTool>$(MSBuildProjectDirectory)\..\..\tools\VeldridAndroidPatch\bin\$(Configuration)\net10.0\VeldridAndroidPatch.dll</_AndroidVeldridPatchTool>
        </PropertyGroup>
        <Exec Condition="'@(_AndroidOriginalVeldrid)' != ''"
              Command="dotnet &quot;$(_AndroidVeldridPatchTool)&quot; &quot;@(_AndroidOriginalVeldrid)&quot; &quot;$(_AndroidPatchedVeldrid)&quot;" />
        <ItemGroup Condition="'@(_AndroidOriginalVeldrid)' != ''">
            <ResolvedFileToPublish Remove="@(_AndroidOriginalVeldrid)" />
            <ResolvedFileToPublish Include="@(_AndroidOriginalVeldrid->'$(_AndroidPatchedVeldrid)')" PostprocessAssembly="true" />
            <!-- ILLink resolves references as well as publish inputs. Both must
                 resolve to the same binary, or it can load the unpatched DLL. -->
            <_AndroidVeldridReference Include="@(ReferencePath)" Condition="'%(Filename)%(Extension)' == 'Veldrid.dll'" />
            <ReferencePath Remove="@(_AndroidVeldridReference)" />
            <ReferencePath Include="@(_AndroidVeldridReference->'$(_AndroidPatchedVeldrid)')" />
            <FileWrites Include="$(_AndroidPatchedVeldrid)" />
        </ItemGroup>
    </Target>

    <Target Name="CheckAndroidVeldridLinkInput" BeforeTargets="_RunILLink" Condition="'$(DesignTimeBuild)' != 'true'">
        <ItemGroup>
            <_AndroidVeldridLinkInput Include="@(ManagedAssemblyToLink)" Condition="'%(Filename)' == 'Veldrid'" />
        </ItemGroup>
        <Error Condition="'@(_AndroidVeldridLinkInput)' != '$(_AndroidPatchedVeldrid)'"
               Text="Android ILLink must consume the patched Veldrid: @(_AndroidVeldridLinkInput)" />
    </Target>

    <Target Name="VerifyLinkedAndroidVeldrid" AfterTargets="ILLink"
            Condition="'$(PublishTrimmed)' == 'true' and '$(_AndroidPatchedVeldrid)' != ''">
        <Exec Command="dotnet &quot;$(_AndroidVeldridPatchTool)&quot; --check &quot;$(IntermediateLinkDir)Veldrid.dll&quot;" />
    </Target>

</Project>
