<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Zhengyan.DigitalWife.Speech.WhisperNet</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Whisper.net speech recognition provider for Zhengyan.DigitalWife.Assistant.</Description>
    <NoWarn>$(NoWarn);NU5100;NU5118</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zhengyan.DigitalWife.Abstractions\Zhengyan.DigitalWife.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Whisper.net" />
    <PackageReference Include="Whisper.net.Runtime" />
    <PackageReference Include="Whisper.net.Runtime.Cuda" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>

