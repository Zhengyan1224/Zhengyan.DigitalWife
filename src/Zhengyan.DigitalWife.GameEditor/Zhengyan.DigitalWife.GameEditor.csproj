<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
        <ApplicationIcon>..\..\assets\mmd\samples\GameData\Logo\favicon.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Zhengyan.DigitalWife.GameEditor.Tests" />
        <PackageReference Include="ImGui.NET" />
        <ProjectReference Include="..\..\tools\VeldridTransparentSwapchainPatch\VeldridTransparentSwapchainPatch.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" />
        <PackageReference Include="Silk.NET.OpenGLES.Extensions.ImGui" />
        <ProjectReference Include="..\Zhengyan.DigitalWife.GameProjects\Zhengyan.DigitalWife.GameProjects.csproj" />
        <ProjectReference Include="..\Zhengyan.DigitalWife.GamePlayer.Android.Scripting\Zhengyan.DigitalWife.GamePlayer.Android.Scripting.csproj" Aliases="AndroidScripting" />
        <ProjectReference Include="..\Zhengyan.DigitalWife.GameProjects.Core\Zhengyan.DigitalWife.GameProjects.Core.csproj" Aliases="AndroidProjects" />
        <ProjectReference Include="..\Zhengyan.DigitalWife.GamePlayer.Runtime.Core\Zhengyan.DigitalWife.GamePlayer.Runtime.Core.csproj" Aliases="AndroidRuntime" />
        <ProjectReference Include="..\Zhengyan.DigitalWife.Mmd.Core\Zhengyan.DigitalWife.Mmd.Core.csproj" Aliases="AndroidMmd" />
        <ProjectReference Include="..\Zhengyan.DigitalWife.Mmd.Game\Zhengyan.DigitalWife.Mmd.Game.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="$(DigitalWifeMmdEngineAssetsDir)**\*">
            <Link>Resources\%(RecursiveDir)%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="..\..\assets\mmd\samples\GameData\Logo\logo.png">
            <Link>Resources\Logo\logo.png</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="..\..\assets\mmd\samples\GameData\Logo\favicon.ico">
            <Link>Resources\Logo\favicon.ico</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="..\..\assets\mmd\samples\GameData\Logo\favicon.png">
            <Link>Resources\Logo\favicon.png</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="..\Zhengyan.DigitalWife.GamePlayer.Runtime.Core\bin\$(Configuration)\net10.0\Zhengyan.DigitalWife.GamePlayer.Runtime.Core.dll">
            <Link>Zhengyan.DigitalWife.GamePlayer.Runtime.Core.dll</Link>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <Visible>False</Visible>
        </None>
        <None Include="..\Zhengyan.DigitalWife.GamePlayer\bin\$(Configuration)\net10.0\Zhengyan.DigitalWife.GamePlayer.dll">
            <Link>Zhengyan.DigitalWife.GamePlayer.dll</Link>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <Visible>False</Visible>
        </None>
        <None Include="..\Zhengyan.DigitalWife.GamePlayer\bin\$(Configuration)\net10.0\Zhengyan.DigitalWife.Llm.OpenAI.dll">
            <Link>Zhengyan.DigitalWife.Llm.OpenAI.dll</Link>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <Visible>False</Visible>
        </None>
    </ItemGroup>

    <Target Name="BuildScriptCompilerContracts" BeforeTargets="Build">
        <MSBuild Projects="..\Zhengyan.DigitalWife.GamePlayer.Runtime.Core\Zhengyan.DigitalWife.GamePlayer.Runtime.Core.csproj"
                 Targets="Build"
                 Properties="Configuration=$(Configuration)" />
        <MSBuild Projects="..\Zhengyan.DigitalWife.GamePlayer\Zhengyan.DigitalWife.GamePlayer.csproj"
                 Targets="Build"
                 Properties="Configuration=$(Configuration)" />
    </Target>

    <Target Name="CopyScriptCompilerContracts" AfterTargets="Build">
        <ItemGroup>
            <ScriptCompilerContractFiles Include="..\Zhengyan.DigitalWife.GamePlayer.Runtime.Core\bin\$(Configuration)\net10.0\Zhengyan.DigitalWife.GamePlayer.Runtime.Core.dll" />
            <ScriptCompilerContractFiles Include="..\Zhengyan.DigitalWife.GamePlayer\bin\$(Configuration)\net10.0\Zhengyan.DigitalWife.GamePlayer.dll" />
            <ScriptCompilerContractFiles Include="..\Zhengyan.DigitalWife.GamePlayer\bin\$(Configuration)\net10.0\Zhengyan.DigitalWife.Llm.OpenAI.dll" />
        </ItemGroup>
        <Copy SourceFiles="@(ScriptCompilerContractFiles)" DestinationFolder="$(TargetDir)" />
    </Target>

    <Target Name="PatchEditorVeldridBuild" AfterTargets="CopyScriptCompilerContracts" Condition="Exists('$(TargetDir)Veldrid.dll')">
        <Exec Command="dotnet &quot;$(MSBuildProjectDirectory)\..\..\tools\VeldridTransparentSwapchainPatch\bin\$(Configuration)\net10.0\VeldridTransparentSwapchainPatch.dll&quot; &quot;$(TargetDir)Veldrid.dll&quot;" />
    </Target>
    <Target Name="PatchEditorVeldridPublish" AfterTargets="Publish" Condition="Exists('$(PublishDir)Veldrid.dll')">
        <Exec Command="dotnet &quot;$(MSBuildProjectDirectory)\..\..\tools\VeldridTransparentSwapchainPatch\bin\$(Configuration)\net10.0\VeldridTransparentSwapchainPatch.dll&quot; &quot;$(PublishDir)Veldrid.dll&quot;" />
    </Target>

</Project>
