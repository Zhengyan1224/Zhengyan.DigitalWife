@page "/"
@implements IAsyncDisposable
@inject WebRuntimeHost RuntimeHost

<PageTitle>Zhengyan Web GamePlayer</PageTitle>

<main class="web-runtime-page">
    <header class="web-runtime-header">
        <div>
            <p class="eyebrow">Zhengyan.DigitalWife</p>
            <h1>Web GamePlayer</h1>
            <p class="subtitle">WebGL2 游戏播放器</p>
        </div>
        <span class="runtime-badge @(RuntimeHost.Snapshot.IsRunning ? "running" : "idle")">
            @RuntimeHost.Snapshot.Status
        </span>
    </header>

    <section class="web-runtime-shell" aria-label="Web 游戏运行时">
        <div class="canvas-frame @(RuntimeHost.Snapshot.RendererReady ? "renderer-ready" : "")">
            <canvas @ref="_canvas" id="game-canvas" aria-label="游戏画布"></canvas>
            <canvas @ref="_overlayCanvas" id="game-overlay" aria-hidden="true"></canvas>
            <div class="canvas-placeholder">
                <strong>正在初始化 WebGL2</strong>
                <span>如果浏览器不支持 WebGL2，错误会显示在右侧面板。</span>
            </div>
        </div>

        <aside class="runtime-panel">
            <h2>运行时状态</h2>
            <div class="loading-progress" aria-label="资源加载进度">
                <div class="loading-progress-track"><span style="width:@(RuntimeHost.Snapshot.LoadingProgress * 100):0.##%"></span></div>
                <small>@RuntimeHost.Snapshot.LoadingStage：@RuntimeHost.Snapshot.LoadingMessage</small>
            </div>
            <label class="package-picker">
                打开 .dwgame 内存包
                <InputFile accept=".dwgame,application/octet-stream" OnChange="OnPackageSelected" />
            </label>
            <label class="package-picker">加密游戏包密码<input type="password" @bind="_packagePassword" autocomplete="off" /></label>
            <label class="package-picker">本地语言模型（GGUF，可分片）<input type="file" accept=".gguf" multiple @ref="_modelInput" @onchange="OnLanguageModelSelected" /></label>
            <button disabled="@_cachingOffline" @onclick="CacheOffline">@(_cachingOffline?"正在保存离线资源…":"保存离线游戏")</button>
            @if(!string.IsNullOrEmpty(_offlineMessage)){<small>@_offlineMessage</small>}
            @if (!string.IsNullOrWhiteSpace(_packageError))
            {
                <div class="runtime-error" role="alert"><strong>包加载错误</strong><span>@_packageError</span></div>
            }
            <dl>
                <div>
                    <dt>主循环</dt>
                    <dd>@(RuntimeHost.Snapshot.IsRunning ? "requestAnimationFrame" : "未启动")</dd>
                </div>
                <div>
                    <dt>渲染器</dt>
                    <dd>@RuntimeHost.Snapshot.RendererName</dd>
                </div>
                <div>
                    <dt>场景</dt>
                    <dd>@(RuntimeHost.Snapshot.SceneReady ? RuntimeHost.Snapshot.SceneName : "未加载")</dd>
                </div>
                <div>
                    <dt>实体</dt>
                    <dd>@RuntimeHost.Snapshot.SceneEntityCount</dd>
                </div>
                <div>
                    <dt>PMX 网格</dt>
                    <dd>@(RuntimeHost.Snapshot.PmxMeshReady ? $"{RuntimeHost.Snapshot.PmxEntityCount} 个模型，{RuntimeHost.Snapshot.PmxModelName} ({RuntimeHost.Snapshot.PmxVertexCount} 顶点)" : "未加载")</dd>
                </div>
                <div>
                    <dt>帧数</dt>
                    <dd>@RuntimeHost.Snapshot.FrameCount</dd>
                </div>
                <div>
                    <dt>Canvas</dt>
                    <dd>@RuntimeHost.Snapshot.CanvasWidth × @RuntimeHost.Snapshot.CanvasHeight</dd>
                </div>
                <div>
                    <dt>设备像素比</dt>
                    <dd>@RuntimeHost.Snapshot.DevicePixelRatio.ToString("0.##")</dd>
                </div>
                <div>
                    <dt>最近帧间隔</dt>
                    <dd>@RuntimeHost.Snapshot.LastDeltaSeconds.ToString("0.000") s</dd>
                </div>
            </dl>

            @if (!string.IsNullOrWhiteSpace(RuntimeHost.Snapshot.LastError))
            {
                <div class="runtime-error" role="alert">
                    <strong>错误</strong>
                    <span>@RuntimeHost.Snapshot.LastError</span>
                </div>
            }
        </aside>
    </section>

    <p class="runtime-note">
        支持加载 Web 游戏项目和 .dwgame 游戏包。
    </p>
</main>

@code {
    private ElementReference _canvas;
    private ElementReference _overlayCanvas;
    private ElementReference _modelInput;
    private bool _cachingOffline;
    private string _offlineMessage="";
    private string _packageError = string.Empty;
    private string _packagePassword = string.Empty;

    protected override void OnInitialized()
    {
        RuntimeHost.Changed += OnRuntimeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RuntimeHost.StartAsync(_canvas, _overlayCanvas);
        }
    }

    private void OnRuntimeChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task OnPackageSelected(InputFileChangeEventArgs args)
    {
        _packageError = string.Empty;
        try
        {
            using Stream source = args.File.OpenReadStream(maxAllowedSize: 1024L * 1024L * 1024L);
            using MemoryStream buffer = new();
            await source.CopyToAsync(buffer);
            await RuntimeHost.LoadDwGameAsync(buffer.ToArray(), _canvas, _overlayCanvas,_packagePassword);
        }
        catch (Exception exception)
        {
            _packageError = exception.GetBaseException().Message;
        }
    }
    private async Task OnLanguageModelSelected()
    {
        _packageError=string.Empty;
        try{await RuntimeHost.SetLanguageModelFilesAsync(_modelInput);}
        catch(Exception exception){_packageError=exception.GetBaseException().Message;}
    }
    private async Task CacheOffline()
    {
        _cachingOffline=true;_offlineMessage="";
        try{int count=await RuntimeHost.CacheOfflineGameAsync();_offlineMessage=$"已保存 {count} 项资源，可断网重新打开。";}
        catch(Exception exception){_offlineMessage=exception.GetBaseException().Message;}
        finally{_cachingOffline=false;}
    }

    public async ValueTask DisposeAsync()
    {
        RuntimeHost.Changed -= OnRuntimeChanged;
        await RuntimeHost.StopAsync();
    }
}
