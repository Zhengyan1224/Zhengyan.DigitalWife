{
  "name": "Demo Game",
  "version": "0.1.0",
  "defaultScene": "scenes/main.scene.json",
  "editorScene": "scenes/main.scene.json",
  "scenes": [
    "scenes/main.scene.json"
  ],
  "scriptRuntime": {
    "preferredLanguage": "csharp",
    "scriptSearchPaths": [
      "scripts"
    ]
  },
  "voice": {
    "enabled": false,
    "playbackBackend": "OpenAL",
    "ttsProvider": "sherpa-onnx",
    "modelKind": "vits",
    "modelPath": "",
    "tokensPath": "",
    "inferenceProvider": "cpu",
    "threads": 2,
    "defaultSpeakerId": 0,
    "defaultSpeed": 1,
    "defaultVolume": 1,
    "preloadOnSceneLoad": true,
    "warmUpText": "\u4F60\u597D",
    "lipSync": {
      "enabled": true,
      "dictionaryDirectory": "Resources/SpeechLipSyncDictionaries",
      "dictionaryLanguage": "Chinese",
      "dictionaryLanguages": [],
      "minFramePeriodMilliseconds": 70,
      "maxFramePeriodMilliseconds": 320,
      "useFallbackVowelOnNoMatch": false,
      "noMatchFallbackVowel": "\u3042",
      "vowelMorphMap": {
        "\u3042": "\u3042",
        "\u3044": "\u3044",
        "\u3046": "\u3046",
        "\u3048": "\u3048",
        "\u304A": "\u304A"
      }
    }
  },
  "microphone": {
    "autoDetectOnPlayerLoad": false
  },
  "asr": {
    "enabled": false,
    "provider": "sherpa",
    "preloadOnSceneLoad": true,
    "partialResultIntervalSeconds": 0.75,
    "endpointSilenceSeconds": 0.9,
    "speechRmsThreshold": 0.008,
    "capture": {
      "sampleRate": 16000,
      "channels": 1,
      "framesPerBuffer": 512
    },
    "sherpa": {
      "modelKind": "OnlineTransducer",
      "tokensPath": "",
      "language": "zh",
      "provider": "cpu",
      "sampleRate": 16000,
      "featureDim": 80,
      "threads": 2,
      "decodingMethod": "greedy_search"
    },
    "whisper": {
      "modelPath": "",
      "language": "auto",
      "translateToEnglish": false,
      "useGpu": false,
      "threads": 2,
      "sampleRate": 16000
    }
  },
  "realtimeVoice": {
    "enabled": false,
    "baseUrl": "http://127.0.0.1:5000",
    "realtimePath": "/v1/realtime",
    "audioSpeechPath": "/v1/audio/speech",
    "apiKey": "",
    "apiKeyEnvironmentVariable": "OPENAI_API_KEY",
    "model": "zhengyan-realtime-voice",
    "instructions": "\u4F60\u662F\u6653\u96E8\uFF0C\u4E00\u4E2A\u6E29\u67D4\u3001\u7B80\u6D01\u3001\u81EA\u7136\u7684\u4E2D\u6587\u8BED\u97F3\u52A9\u624B\u3002\u8BF7\u76F4\u63A5\u56DE\u7B54\u7528\u6237\u95EE\u9898\uFF0C\u907F\u514D\u5197\u957F\u3002",
    "voice": "0",
    "connectTimeoutSeconds": 30,
    "outboundAudioChunkSamples": 4096,
    "inputAudioSampleRate": 24000,
    "outputAudioSampleRate": 24000,
    "inputTranscriptionModel": "whisper-1",
    "inputTranscriptionLanguage": "zh",
    "inputTranscriptionPrompt": "",
    "maxOutputTokens": 1024,
    "temperature": 0.7,
    "outputVolume": 1,
    "promptSpeed": 1,
    "userCapture": {
      "preRollSeconds": 0.25,
      "minDurationSeconds": 0.8,
      "maxDurationSeconds": 20,
      "silenceTimeoutSeconds": 0.9,
      "silenceThreshold": 0.015,
      "sampleRate": 16000,
      "channels": 1,
      "framesPerBuffer": 512
    },
    "wakeWord": {
      "enabled": false,
      "keywords": [],
      "chunkDurationSeconds": 2,
      "extensionDurationSeconds": 1.2,
      "trailingSilencePaddingSeconds": 0.4,
      "capture": {
        "sampleRate": 16000,
        "channels": 1,
        "framesPerBuffer": 512
      }
    }
  },
  "llm": {
    "enabled": false,
    "enableSkills": false,
    "enableMemory": false,
    "provider": "openai-compatible",
    "baseUrl": "https://api.openai.com",
    "apiKey": "",
    "apiKeyEnvironmentVariable": "OPENAI_API_KEY",
    "model": "gpt-4o-mini",
    "chatCompletionsPath": "/v1/chat/completions",
    "timeoutSeconds": 300
  },
  "window": {
    "title": "Demo Game",
    "iconPath": "",
    "desktopSpriteMode": false,
    "desktopSpriteClickThrough": false,
    "desktopSpriteDragButton": "none",
    "desktopSpriteTrayEnabled": false,
    "desktopSpriteTrayIconPath": "",
    "desktopSpriteTrayWindowsIconPath": "",
    "desktopSpriteTrayLinuxIconPath": "",
    "desktopSpriteTrayMacOSIconPath": "",
    "desktopSpriteTrayMenuItems": [
      {
        "id": "toggle_visibility",
        "text": "Show / Hide",
        "enabled": true,
        "builtInAction": "toggle_visibility",
        "eventName": "tray_toggle_visibility"
      },
      {
        "id": "exit",
        "text": "Exit",
        "enabled": true,
        "builtInAction": "exit",
        "eventName": "tray_exit"
      }
    ],
    "width": 720,
    "height": 1280,
    "fullscreen": false,
    "resizable": true,
    "timingMode": "time_synchronized",
    "antiAliasingSamples": 4
  },
  "runtime": {
    "graphicsBackend": "OpenGL",
    "useOpenCL": true,
    "useVulkanCompute": true
  },
  "androidQuality": {
    "profile": "auto",
    "targetFrameRate": 60,
    "maxShadowMapSize": 1024,
    "maxLocalShadowMapSize": 512,
    "maxPointShadowMaps": 2,
    "maxSpotShadowMaps": 2,
    "maxReflectionSurfaces": 4,
    "maxParticleCount": 2000,
    "textureMemoryBudgetMb": 256,
    "renderTargetMemoryBudgetMb": 96,
    "drawCallBudget": 3500,
    "dynamicDegradation": true,
    "dynamicFrameBudgetMs": 16.67
  }
}