<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <BlazorWebAssemblyJiterpreter>true</BlazorWebAssemblyJiterpreter>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <RunAOTCompilation Condition="'$(Configuration)' == 'Release'">true</RunAOTCompilation>
  </PropertyGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot/sw.js" PublishedContent="wwwroot/sw.js" />
    <Content Include="../../assets/mmd/engine/Resources/Water/*" Link="wwwroot/engine/Water/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../assets/mmd/engine/Resources/Skybox/*" Link="wwwroot/engine/Skybox/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../assets/mmd/engine/Resources/Particles/*" Link="wwwroot/engine/Particles/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../assets/mmd/engine/Resources/MMD/toon*.bmp" Link="wwwroot/engine/MMD/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../assets/mmd/engine/Resources/SpeechLipSyncDictionaries/*" Link="wwwroot/engine/SpeechLipSyncDictionaries/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <ProjectReference Include="..\Zhengyan.DigitalWife.GamePlayer.Runtime.Core\Zhengyan.DigitalWife.GamePlayer.Runtime.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="WebScriptTrimming.xml" />
    <!-- Game data uses reflection-based JSON, and exported Web scripts call
         the shared runtime API dynamically. Preserve these assembly contracts
         when trimming an AOT publication. -->
    <TrimmerRootAssembly Include="Zhengyan.DigitalWife.GamePlayer.Web" />
    <TrimmerRootAssembly Include="Zhengyan.DigitalWife.GamePlayer.Runtime.Core" />
    <TrimmerRootAssembly Include="Zhengyan.DigitalWife.GameProjects.Core" />
    <TrimmerRootAssembly Include="Zhengyan.DigitalWife.Mmd.Core" />
    <TrimmerRootAssembly Include="Zhengyan.DigitalWife.Abstractions" />
    <!-- Precompiled scripts are loaded after trimming and commonly log GUI
         events. Their Console calls are not visible to the linker. -->
    <TrimmerRootAssembly Include="System.Console" />
  </ItemGroup>

  <Target Name="VersionWebRuntimeAssets" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_WebRuntimeJavaScript Include="wwwroot/js/*.js" />
      <_WebRuntimeEngineAssets Include="../../assets/mmd/engine/Resources/Water/*;../../assets/mmd/engine/Resources/Skybox/*;../../assets/mmd/engine/Resources/Particles/*;../../assets/mmd/engine/Resources/MMD/toon*.bmp;../../assets/mmd/engine/Resources/SpeechLipSyncDictionaries/*" />
      <_WebRuntimeVendorAssets Include="wwwroot/vendor/**/*" />
    </ItemGroup>
    <GetFileHash Files="@(_WebRuntimeJavaScript)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_WebRuntimeJavaScriptHashes" />
    </GetFileHash>
    <GetFileHash Files="@(_WebRuntimeEngineAssets)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_WebRuntimeEngineHashes" />
    </GetFileHash>
    <GetFileHash Files="@(_WebRuntimeVendorAssets)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_WebRuntimeVendorHashes" />
    </GetFileHash>
    <PropertyGroup>
      <_WebRuntimeAssetsHash>@(_WebRuntimeJavaScriptHashes->'%(FileHash)', '')</_WebRuntimeAssetsHash>
      <_WebRuntimeEngineHash>@(_WebRuntimeEngineHashes->'%(FileHash)', '')@(_WebRuntimeVendorHashes->'%(FileHash)', '')</_WebRuntimeEngineHash>
    </PropertyGroup>
    <!-- A JS-only change must also change the module ID used by JS interop. -->
    <WriteLinesToFile File="$(IntermediateOutputPath)WebRuntimeAssets.g.cs"
                      Lines="[assembly: System.Reflection.AssemblyMetadataAttribute(&quot;WebRuntimeAssets&quot;, &quot;$(_WebRuntimeAssetsHash)&quot;)];[assembly: System.Reflection.AssemblyMetadataAttribute(&quot;WebEngineAssets&quot;, &quot;$(_WebRuntimeEngineHash)&quot;)]"
                      Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)WebRuntimeAssets.g.cs" />
    </ItemGroup>
  </Target>

</Project>
