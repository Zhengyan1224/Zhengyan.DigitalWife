<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- This runs on the build host; it is not an Android executable dependency. -->
    <ShouldBeValidatedAsExecutableReference>false</ShouldBeValidatedAsExecutableReference>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\VeldridCommonPatch\VeldridMemorySafetyPatch.cs" Link="VeldridMemorySafetyPatch.cs" />
    <PackageReference Include="Mono.Cecil" />
    <PackageReference Include="Veldrid" />
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>
</Project>
